# BASE44 SANDBOX ONLY — deliberately does not point at the production tenant.
# This exists so a preview/build cannot silently fall back to Boston production config.
VITE_BASE44_APP_ID=sandbox-not-configured
VITE_BASE44_BACKEND_URL=
VITE_USE_LOCAL_AUTH=false
VITE_STANDALONE_LOCAL=false
VITE_USE_SERVER_AUTH=false
VITE_USE_D1_API=false
VITE_USE_SERVER_DATA_SYNC=false
VITE_WEBSOCKET_ENDPOINT=
